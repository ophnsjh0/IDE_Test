# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables — API keys live here, never commit
.env

# Local SQLite DB — 계정 정보 포함, 커밋 금지 (Postgres 전환 시까지 로컬 전용)
backend/db.sqlite3

# Gmail OAuth secrets — never commit these
backend/credentials.json
backend/token.json
credentials.json
token.json

# 동기화(Gmail/지식) 동시 실행 방지용 잠금 파일
backend/.gmail_sync.lock
backend/.knowledge_sync.lock
backend/.reference_embed.lock

# collectstatic 산출물 (도커 빌드 시 이미지 안에서 생성)
backend/staticfiles/

# 사내 보고서 템플릿 — 실물 템플릿에 내부 정보(로고·결재선)가 들어가므로 커밋 금지
backend/report_templates/
backend/reference_docs/

# pull-vm-data.sh가 남기는 타임스탬프 백업 (수백 MB, 운영 데이터 포함)
backend/db.sqlite3.bak-*

# 지식 항목에 붙는 구성도·캡처 이미지 (운영 데이터, 저장소에 넣지 않는다)
backend/knowledge_images/
